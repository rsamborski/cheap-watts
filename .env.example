# --- Pstryk API ---
PSTRYK_API_KEY=

# --- Deye Inverter / Storage ---
DEYE_MODBUS_HOST=
DEYE_MODBUS_PORT=8899
DEYE_LOGGER_SERIAL=
DEYE_APP_ID=
DEYE_APP_SECRET=

# --- BMW CarData (BMW & MINI) ---
BMW_CARDATA_CLIENT_ID=
MINI_CARDATA_CLIENT_ID=
