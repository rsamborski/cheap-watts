# ==========================================
# .env.example — Copy to .env and fill in values
# ==========================================
# ⚠️  NEVER commit .env — only .env.example
# ⚠️  Leave values BLANK here (no placeholders that look like real keys)
# ==========================================

# --- Pstryk API ---
PSTRYK_API_KEY=
PSTRYK_BASE_URL=https://api.pstryk.pl

# --- Deye Inverter / Storage (Cloud Open API & Local Options) ---
DEYE_MODBUS_HOST=
DEYE_MODBUS_PORT=8899
DEYE_LOGGER_SERIAL=
DEYE_APP_ID=
DEYE_APP_SECRET=
DEYE_EMAIL=
DEYE_PASSWORD=
DEYE_ACCESS_TOKEN=
DEYE_API_BASE_URL=https://eu1-developer.deyecloud.com
DEYE_DEVICE_SN=
DEYE_STATION_ID=

# --- Deye Home Battery Parameters ---
BATTERY_CAPACITY_KWH=10.0
BATTERY_TARGET_SOC=95
BATTERY_MIN_SOC=20
BATTERY_MAX_CHARGE_KW=5.0

# --- BMW CarData (BMW & MINI) ---
CARDATA_BASE_URL=https://api-cardata.bmwgroup.com
CARDATA_TOKEN_URL=https://customer.bmwgroup.com/gcdm/oauth/token
BMW_CARDATA_CLIENT_ID=
BMW_VIN=
BMW_CARDATA_ACCESS_TOKEN=
BMW_CARDATA_REFRESH_TOKEN=
MINI_CARDATA_CLIENT_ID=
MINI_VIN=
MINI_CARDATA_ACCESS_TOKEN=
MINI_CARDATA_REFRESH_TOKEN=
BMW_SOC_THRESHOLD=20
MINI_SOC_THRESHOLD=40
EV_SLOW_CHARGE_AMPS=8

# --- Solar / PV Forecast (Open-Meteo) ---
SOLAR_BASE_URL=https://api.open-meteo.com
SOLAR_LATITUDE=
SOLAR_LONGITUDE=
SOLAR_KWP=
SOLAR_TILT_DEGREES=35.0
SOLAR_AZIMUTH_DEGREES=0.0
# Optional 2nd string for dual-plane (e.g. East/West: -90.0 / 90.0) arrays:
SOLAR_KWP_2=
SOLAR_TILT_DEGREES_2=
SOLAR_AZIMUTH_DEGREES_2=
SOLAR_SYSTEM_EFFICIENCY=0.85
SOLAR_SUFFICIENT_KWH_THRESHOLD=12.0

# --- Email Notifications (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_TO_EMAIL=

# --- Runtime, Logging & State ---
DRY_RUN=false
TIMEZONE=Europe/Warsaw
LOG_LEVEL=INFO
LOG_DIR=logs
STATE_FILE=data/state.json
ALERT_COOLDOWN_HOURS=12
